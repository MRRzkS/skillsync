NEXT_PUBLIC_SUPABASE_URL=
# Required — used by the login/auth flow (lib/supabase/client.ts, middleware.ts).
# Get it from Supabase Dashboard -> Settings -> API.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Fallback provider — every AI call retries against Gemini when OpenRouter
# fails (rate limit, outage). Get a free key from https://aistudio.google.com/apikey.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
